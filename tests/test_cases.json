{
  "version": "v0.1-P2",
  "note": "验收硬 Case（需求书 第七章）。测试读取本文件驱动 solve_circuit，预期值随内核校准可更新。",
  "cases": [
    {
      "id": "HC1_closed",
      "desc": "串联电路开关全闭合：灯亮、电流表有读数、电压表读灯泡电压",
      "mode": "junior",
      "elements": [
        {"id": "b1", "type": "battery", "nodes": ["n1", "n2"], "props": {"E": 3.0, "r_internal": 0.0}},
        {"id": "s1", "type": "switch", "nodes": ["n2", "n3"], "props": {"closed": true}},
        {"id": "lamp1", "type": "bulb", "nodes": ["n3", "n4"], "props": {"resistance": 10.0}},
        {"id": "a1", "type": "ammeter", "nodes": ["n4", "n5"], "props": {}},
        {"id": "s2", "type": "switch", "nodes": ["n5", "n6"], "props": {"closed": true}},
        {"id": "w1", "type": "wire", "nodes": ["n6", "n1"], "props": {}},
        {"id": "v1", "type": "voltmeter", "nodes": ["n3", "n4"], "props": {}}
      ],
      "expect": {
        "bulb_current_min": 0.29,
        "bulb_current_max": 0.31,
        "bulb_on": true,
        "voltmeter_min": 2.9,
        "voltmeter_max": 3.0
      }
    },
    {
      "id": "HC1_open",
      "desc": "硬 Case #1：串联开关断开 → 全灭、电表读数归零（|I|<1e-6）",
      "mode": "junior",
      "elements": [
        {"id": "b1", "type": "battery", "nodes": ["n1", "n2"], "props": {"E": 3.0, "r_internal": 0.0}},
        {"id": "s1", "type": "switch", "nodes": ["n2", "n3"], "props": {"closed": true}},
        {"id": "lamp1", "type": "bulb", "nodes": ["n3", "n4"], "props": {"resistance": 10.0}},
        {"id": "a1", "type": "ammeter", "nodes": ["n4", "n5"], "props": {}},
        {"id": "s2", "type": "switch", "nodes": ["n5", "n6"], "props": {"closed": false}},
        {"id": "w1", "type": "wire", "nodes": ["n6", "n1"], "props": {}},
        {"id": "v1", "type": "voltmeter", "nodes": ["n3", "n4"], "props": {}}
      ],
      "expect": {
        "max_abs_current_any": 1e-6,
        "bulb_on": false
      }
    },
    {
      "id": "HC3_short_wire",
      "desc": "硬 Case #3：纯导线短接电源 → 返回 error=short，不崩溃",
      "mode": "junior",
      "elements": [
        {"id": "b1", "type": "battery", "nodes": ["n1", "n2"], "props": {"E": 3.0}},
        {"id": "w1", "type": "wire", "nodes": ["n1", "n2"], "props": {}}
      ],
      "expect": {"error": "short"}
    },
    {
      "id": "HC2_senior",
      "desc": "硬 Case #2：高中模式电压表内阻有限 → 路端电压 < E（回归断言）",
      "mode": "senior",
      "elements": [
        {"id": "b1", "type": "battery", "nodes": ["n1", "n2"], "props": {"E": 3.0, "r_internal": 0.5}},
        {"id": "r1", "type": "resistor", "nodes": ["n1", "n2"], "props": {"resistance": 10.0}},
        {"id": "v1", "type": "voltmeter", "nodes": ["n1", "n2"], "props": {"r_internal": 10000.0}}
      ],
      "expect": {
        "terminal_less_than_E": true,
        "terminal_min": 2.8,
        "terminal_max": 2.9,
        "voltmeter_max": 3.0
      }
    },
    {
      "id": "HC2_junior_regression",
      "desc": "初中回归：同拓扑理想化 → 路端电压必须等于 E（内阻隐藏、电压表∞）",
      "mode": "junior",
      "elements": [
        {"id": "b1", "type": "battery", "nodes": ["n1", "n2"], "props": {"E": 3.0, "r_internal": 0.5}},
        {"id": "r1", "type": "resistor", "nodes": ["n1", "n2"], "props": {"resistance": 10.0}},
        {"id": "v1", "type": "voltmeter", "nodes": ["n1", "n2"], "props": {"r_internal": 10000.0}}
      ],
      "expect": {
        "terminal_exact": 3.0
      }
    },
    {
      "id": "HC3_short_switch",
      "desc": "闭合开关直接并联电源（旁路负载电阻）→ short",
      "mode": "junior",
      "elements": [
        {"id": "b1", "type": "battery", "nodes": ["n1", "n2"], "props": {"E": 3.0}},
        {"id": "r_load", "type": "resistor", "nodes": ["n1", "n2"], "props": {"resistance": 100.0}},
        {"id": "s1", "type": "switch", "nodes": ["n1", "n2"], "props": {"closed": true}}
      ],
      "expect": {"error": "short"}
    }
  ]
}
